@@ -0,0 +1,27 @@
+#pragma once
+
+#include "whats_next/frame_contract.hpp"
+
+namespace whats_next {
+
+enum class HistoryDecision : std::uint8_t {
+    RejectInvalidCurrent,
+    RejectNoPrevious,
+    RejectDiscontinuity,
+    RejectResourceChanged,
+    RejectSessionChanged,
+    Accept
+};
+
+class HistoryGate {
+public:
+    HistoryDecision evaluate(const FrameContract& current) const noexcept;
+    void commit(const FrameContract& completed) noexcept;
+    void reset() noexcept;
+
+private:
+    FrameContract previous_{};
+    bool has_previous_ = false;
+};
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/include/whats_next/frame_generation_policy.hpp b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_policy.hpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_policy.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "whats_next/frame_contract.hpp"
+#include "whats_next/history_gate.hpp"
+
+#include <cstdint>
+
+namespace whats_next {
+
+// Scheduling policy inspired by M33's optional 30->60 presentation interpolation.
+// It deliberately does not own Vulkan resources or assume PPSSPP/Flycast types.
+enum class FrameGenerationDecision : std::uint8_t {
+    BypassDisabled,
+    PresentRealFirstFrame,
+    PresentRealCadenceMismatch,
+    PresentRealHistoryRejected,
+    GenerateIntermediate
+};
+
+struct PresentationCadence {
+    // Number of display refresh intervals between the previous and current real frame.
+    // M33's 30->60 case is 2 on a 60 Hz display.
+    std::uint32_t refresh_intervals = 0;
+};
+
+class FrameGenerationPolicy {
+public:
+    FrameGenerationDecision decide(
+        bool enabled,
+        const FrameContract& current,
+        HistoryDecision history,
+        PresentationCadence cadence) const noexcept;
+};
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/include/whats_next/frame_generation_controller.hpp b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_controller.hpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_controller.hpp
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "whats_next/frame_generation_policy.hpp"
+#include "whats_next/history_gate.hpp"
+
+namespace whats_next {
+
+// Stateful, backend-neutral coordinator for frame admission. The renderer asks
+// decide() for each real source frame, then calls commit_real_frame() only after
+// that source frame is accepted as the new history reference. Generated frames
+// must never be committed as source history.
+class FrameGenerationController {
+public:
+    FrameGenerationDecision decide(
+        bool enabled,
+        const FrameContract& current,
+        PresentationCadence cadence) const noexcept;
+
+    void commit_real_frame(const FrameContract& completed) noexcept;
+    void reset() noexcept;
+
+private:
+    HistoryGate history_;
+    FrameGenerationPolicy policy_;
+};
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/include/whats_next/frame_generation_bridge.hpp b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_bridge.hpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/include/whats_next/frame_generation_bridge.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include "whats_next/frame_generation_controller.hpp"
+
+#include <cstdint>
+
+namespace whats_next {
+
+// Small renderer-facing bridge. The backend supplies stable session/resource
+// generations and real-frame dimensions/format; this class owns the monotonically
+// increasing ID for real source frames. Repeated vblanks and generated frames must
+// not call begin_real_frame().
+class FrameGenerationBridge {
+public:
+    FrameGenerationDecision begin_real_frame(
+        bool enabled,
+        std::uint32_t width,
+        std::uint32_t height,
+        PixelFormat format,
+        std::uint64_t resource_generation,
+        std::uint64_t game_session,
+        PresentationCadence cadence) noexcept;
+
+    // Call only after the real source frame has been accepted by the renderer.
+    // Call for real frames even when generation was rejected, so history can recover.
+    void commit_real_frame() noexcept;
+
+    // Call on renderer teardown, game switch, or any resource/session reset.
+    void reset() noexcept;
+
+    std::uint64_t current_frame_id() const noexcept { return next_frame_id_; }
+
+private:
+    FrameGenerationController controller_;
+    FrameContract pending_{};
+    std::uint64_t next_frame_id_ = 1;
+    bool pending_valid_ = false;
+};
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/src/history_gate.cpp b/core/rend/vulkan/whats_next/src/history_gate.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/src/history_gate.cpp
@@ -0,0 +1,43 @@
+#include "whats_next/history_gate.hpp"
+
+namespace whats_next {
+
+HistoryDecision HistoryGate::evaluate(const FrameContract& current) const noexcept {
+    if (!is_valid(current))
+        return HistoryDecision::RejectInvalidCurrent;
+
+    if (!has_previous_)
+        return HistoryDecision::RejectNoPrevious;
+
+    if (current.game_session != previous_.game_session)
+        return HistoryDecision::RejectSessionChanged;
+
+    if (current.resource_generation != previous_.resource_generation ||
+        current.width != previous_.width ||
+        current.height != previous_.height ||
+        current.format != previous_.format)
+        return HistoryDecision::RejectResourceChanged;
+
+    // This first version only accepts consecutive frames. If frames were
+    // dropped, never blend stale history and introduce a visible ghost.
+    if (previous_.frame_id == UINT64_MAX || current.frame_id != previous_.frame_id + 1)
+        return HistoryDecision::RejectDiscontinuity;
+
+    return HistoryDecision::Accept;
+}
+
+void HistoryGate::commit(const FrameContract& completed) noexcept {
+    if (!is_valid(completed)) {
+        reset();
+        return;
+    }
+    previous_ = completed;
+    has_previous_ = true;
+}
+
+void HistoryGate::reset() noexcept {
+    previous_ = {};
+    has_previous_ = false;
+}
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/src/frame_generation_policy.cpp b/core/rend/vulkan/whats_next/src/frame_generation_policy.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/src/frame_generation_policy.cpp
@@ -0,0 +1,31 @@
+#include "whats_next/frame_generation_policy.hpp"
+
+namespace whats_next {
+
+FrameGenerationDecision FrameGenerationPolicy::decide(
+    bool enabled,
+    const FrameContract& current,
+    HistoryDecision history,
+    PresentationCadence cadence) const noexcept {
+    if (!enabled)
+        return FrameGenerationDecision::BypassDisabled;
+
+    // Invalid frames must never enter a temporal reconstruction pass.
+    if (!is_valid(current))
+        return FrameGenerationDecision::PresentRealHistoryRejected;
+
+    if (history == HistoryDecision::RejectNoPrevious)
+        return FrameGenerationDecision::PresentRealFirstFrame;
+
+    if (history != HistoryDecision::Accept)
+        return FrameGenerationDecision::PresentRealHistoryRejected;
+
+    // M33 only interpolates when a 30 FPS source frame would otherwise be repeated
+    // across two display refreshes. Never synthesize on unknown/other cadence.
+    if (cadence.refresh_intervals != 2)
+        return FrameGenerationDecision::PresentRealCadenceMismatch;
+
+    return FrameGenerationDecision::GenerateIntermediate;
+}
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/src/frame_generation_controller.cpp b/core/rend/vulkan/whats_next/src/frame_generation_controller.cpp
