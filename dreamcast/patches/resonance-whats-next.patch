+++ b/core/rend/vulkan/whats_next/src/frame_generation_controller.cpp
@@ -0,0 +1,21 @@
+#include "whats_next/frame_generation_controller.hpp"
+
+namespace whats_next {
+
+FrameGenerationDecision FrameGenerationController::decide(
+    bool enabled,
+    const FrameContract& current,
+    PresentationCadence cadence) const noexcept {
+    return policy_.decide(enabled, current, history_.evaluate(current), cadence);
+}
+
+void FrameGenerationController::commit_real_frame(
+    const FrameContract& completed) noexcept {
+    history_.commit(completed);
+}
+
+void FrameGenerationController::reset() noexcept {
+    history_.reset();
+}
+
+} // namespace whats_next

diff --git a/core/rend/vulkan/whats_next/src/frame_generation_bridge.cpp b/core/rend/vulkan/whats_next/src/frame_generation_bridge.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/core/rend/vulkan/whats_next/src/frame_generation_bridge.cpp
@@ -0,0 +1,51 @@
+#include "whats_next/frame_generation_bridge.hpp"
+
+#include <limits>
+
+namespace whats_next {
+
+FrameGenerationDecision FrameGenerationBridge::begin_real_frame(
+    bool enabled,
+    std::uint32_t width,
+    std::uint32_t height,
+    PixelFormat format,
+    std::uint64_t resource_generation,
+    std::uint64_t game_session,
+    PresentationCadence cadence) noexcept {
+    // A second begin without a commit means the renderer abandoned an
+    // in-flight source frame. Invalidate temporal history rather than allowing
+    // a decision made for that frame to be committed against a replacement.
+    if (pending_valid_) {
+        controller_.reset();
+        pending_valid_ = false;
+    }
+    if (next_frame_id_ == 0 || next_frame_id_ == std::numeric_limits<std::uint64_t>::max()) {
+        // Avoid wrapping IDs and accidentally treating stale history as consecutive.
+        controller_.reset();
+        next_frame_id_ = 1;
+    }
+
+    pending_ = FrameContract{
+        width, height, format, next_frame_id_,
+        resource_generation, game_session, false, false
+    };
+    pending_valid_ = true;
+    return controller_.decide(enabled, pending_, cadence);
+}
+
+void FrameGenerationBridge::commit_real_frame() noexcept {
+    if (!pending_valid_)
+        return;
+    controller_.commit_real_frame(pending_);
+    pending_valid_ = false;
+    ++next_frame_id_;
+}
+
+void FrameGenerationBridge::reset() noexcept {
+    controller_.reset();
+    pending_ = {};
+    pending_valid_ = false;
+    next_frame_id_ = 1;
+}
+
+} // namespace whats_next

